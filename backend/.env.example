# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SMTP / Production Email (Nodemailer) ──────────────────────────────────────
# For Gmail: Use an App Password (not your personal account password)
# For SendGrid / Mailgun / AWS SES / Brevo / Custom SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Aliases supported in production:
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=no-reply@yourdomain.com
# SMTP_SECURE=false (auto-detected: true for port 465, false for 587)
# SMTP_SERVICE=gmail
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Fleet Management System

# ── Firebase Cloud Messaging (FCM) ──────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# ── SMS Gateway Configuration (Twilio / Fast2SMS / MSG91) ────────────────────
# Option 1: Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Option 2: Fast2SMS (India)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 3: MSG91 (India / International)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_msg91_dlt_template_id

